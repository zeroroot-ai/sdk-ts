{
  "name": "@zeroroot-ai/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Gibson platform: connect-es bindings, Capability Grant auth, component registration, and an OpenAI-compatible LLM shim. Framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "buf generate buf.build/zeroroot-ai/sdk && buf generate buf.build/bufbuild/protovalidate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build",
    "test": "sh -c 'tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"' swallow-forwarded-vitest-args",
    "lint": "oxlint src --ignore-pattern 'src/gen/**' --deny-warnings"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

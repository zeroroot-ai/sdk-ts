{
  // Tests are built to a separate output tree so the published `dist` stays
  // production-only. NodeNext requires `.js` import specifiers in source, which
  // node's type-stripping cannot resolve from `src` — so tests run compiled.
  //
  // `scripts` is in this tree and not in tsconfig.json: the generator is not
  // published, but it is typechecked, because `pnpm test` compiles this
  // project and the generator's parser has its own tests.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "rootDir": ".",
    "declaration": false
  },
  "exclude": [],
  "include": ["src", "scripts"]
}
